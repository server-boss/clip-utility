#!/bin/bash
# Post-install script for clip-utility
# Installs CLI tools and optional Clip Menu.app

INSTALL_DIR="/usr/local/bin"
SRC_DIR="/tmp/clip-utility-install/Resources"

mkdir -p "$INSTALL_DIR"

# Install CLI tools
cp "$SRC_DIR/clip" "$INSTALL_DIR/clip"
cp "$SRC_DIR/clip-tui" "$INSTALL_DIR/clip-tui"
cp "$SRC_DIR/clip-menu" "$INSTALL_DIR/clip-menu"

chmod +x "$INSTALL_DIR/clip"
chmod +x "$INSTALL_DIR/clip-tui"
chmod +x "$INSTALL_DIR/clip-menu"

# Build and install Clip Menu.app
APP_DIR="/Applications/Clip Menu.app"
rm -rf "$APP_DIR"

osacompile -o "$APP_DIR" -e '
on run
  do shell script "/usr/local/bin/clip-menu"
end run
'

# Set app icon metadata and hide from Dock when running
defaults write "$APP_DIR/Contents/Info" CFBundleIdentifier "com.server-boss.clip-menu"
defaults write "$APP_DIR/Contents/Info" CFBundleName "Clip Menu"

# Create a custom icon using the scissors emoji
ICON_SCRIPT='
  tell application "System Events"
    -- App is ready to use from Spotlight/Launchpad
  end tell
'

echo "✓ Installed clip, clip-tui, clip-menu to $INSTALL_DIR"
echo "✓ Installed Clip Menu.app to /Applications"

exit 0
