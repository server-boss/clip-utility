#!/usr/bin/env bash
set -eo pipefail
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# ──────────────────────────────────────────────
# clip-tui — interactive clipboard transformer
# ──────────────────────────────────────────────
# Uses fzf multi-select with live preview.
# Select transforms with Tab, press Enter to apply.

CLIP="clip"

# ── Platform clipboard helpers ──
_is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

clip_paste() {
  case "$(uname -s)" in
    Darwin)  pbpaste ;;
    Linux)
      if _is_wsl; then powershell.exe -NoProfile -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Get-Clipboard" 2>/dev/null | sed 's/\r$//'
      elif command -v wl-paste &>/dev/null; then wl-paste 2>/dev/null
      elif command -v xclip &>/dev/null; then xclip -selection clipboard -o 2>/dev/null
      elif command -v xsel &>/dev/null; then xsel --clipboard --output 2>/dev/null
      fi ;;
  esac
}

clip_clear() {
  case "$(uname -s)" in
    Darwin)  pbcopy < /dev/null ;;
    Linux)
      if _is_wsl; then powershell.exe -NoProfile -Command "Set-Clipboard -Value ''" 2>/dev/null
      elif command -v xclip &>/dev/null; then echo -n | xclip -selection clipboard -i 2>/dev/null
      elif command -v wl-copy &>/dev/null; then wl-copy --clear 2>/dev/null
      fi ;;
  esac
}

# ──────────────────────────────────────────────
# Label → flags mapping
# ──────────────────────────────────────────────

label_to_flags() {
  case "$1" in
    # Presets
    "Claude → Markdown"*)                 echo "--claude --unwrap" ;;
    "Claude → Rich"*)                     echo "--claude --unwrap --tohtml" ;;
    "Claude → Excel"*)                    echo "--claude --unwrap --toexcel" ;;
    "Rich → Markdown"*)                   echo "--md --rtrim --strip-blank" ;;
    "Markdown → Rich"*)                   echo "--tohtml" ;;
    "Clean list"*)                        echo "--trim --dedup" ;;
    "Flatten text"*)                      echo "--trim --unformat --unwrap --collapse" ;;
    # Clipboard Source
    "--claude"*)                          echo "--claude" ;;
    "--md2csv"*)                          echo "--md2csv" ;;
    "--md2html"*)                         echo "--md2html" ;;
    "--md "*)                             echo "--md" ;;
    "--boxtable"*)                        echo "--boxtable" ;;
    "--unwrap"*)                          echo "--unwrap" ;;
    "--strip-blank"*)                     echo "--strip-blank" ;;
    "--trim"*)                            echo "--trim" ;;
    "--rtrim"*)                           echo "--rtrim" ;;
    "--collapse"*)                        echo "--collapse" ;;
    "--dedup"*)                           echo "--dedup" ;;
    "--unformat"*)                        echo "--unformat" ;;
    "--lower"*)                           echo "--lower" ;;
    "--upper"*)                           echo "--upper" ;;
    "--title"*)                           echo "--title" ;;
    "--sentence"*)                        echo "--sentence" ;;
    "--sort-r"*)                          echo "--sort-r" ;;
    "--sort"*)                            echo "--sort" ;;
    "--tohtml"*)                          echo "--tohtml" ;;
    "--toexcel"*)                         echo "--toexcel" ;;
    "--csv2md"*)                          echo "--csv2md" ;;
    "--csv2html"*)                        echo "--csv2html" ;;
    *) ;;
  esac
}

# ──────────────────────────────────────────────
# Build the preview script
# ──────────────────────────────────────────────

# Temp files
CLIP_TMP="${TMPDIR:-/tmp}/.clip-tui-input-$$"
SEL_FILE="${TMPDIR:-/tmp}/.clip-tui-selections-$$"
TOGGLE_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-toggle-$$"
REFRESH_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-refresh-$$"
PREVIEW_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-preview-$$"
clip_paste > "$CLIP_TMP"
: > "$SEL_FILE"
trap 'rm -f "$CLIP_TMP" "$SEL_FILE" "$TOGGLE_SCRIPT" "$REFRESH_SCRIPT" "$PREVIEW_SCRIPT"' EXIT

# Toggle script — tracks selections in toggle order using line numbers
# Uses {n} (0-based line index) to avoid special character matching issues
cat > "$TOGGLE_SCRIPT" << TOGGLE_EOF
#!/usr/bin/env bash
SEL_FILE="$SEL_FILE"
line_num="\$1"
if grep -qx "\$line_num" "\$SEL_FILE" 2>/dev/null; then
  { grep -vx "\$line_num" "\$SEL_FILE" || true; } > "\$SEL_FILE.tmp"
  mv "\$SEL_FILE.tmp" "\$SEL_FILE"
else
  echo "\$line_num" >> "\$SEL_FILE"
fi
TOGGLE_EOF
chmod +x "$TOGGLE_SCRIPT"

# Items list file — so preview can resolve line numbers to labels
ITEMS_FILE="${TMPDIR:-/tmp}/.clip-tui-items-$$"
trap 'rm -f "$CLIP_TMP" "$SEL_FILE" "$TOGGLE_SCRIPT" "$REFRESH_SCRIPT" "$PREVIEW_SCRIPT" "$ITEMS_FILE"' EXIT

# Refresh script — re-reads clipboard into the cache file
cat > "$REFRESH_SCRIPT" << REFRESH_EOF
#!/usr/bin/env bash
$(declare -f _is_wsl)
$(declare -f clip_paste)
clip_paste > "$CLIP_TMP"
REFRESH_EOF
chmod +x "$REFRESH_SCRIPT"

PREVIEW_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-preview-$$"
cat > "$PREVIEW_SCRIPT" << 'PREVIEW_EOF'
#!/usr/bin/env bash
set -eo pipefail
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

CLIP="clip"
CLIP_TMP="$1"
SEL_FILE="$2"
ITEMS_FILE="$3"

label_to_flags() {
  case "$1" in
    "Claude → Markdown"*)                 echo "--claude --unwrap" ;;
    "Claude → Rich"*)                     echo "--claude --unwrap --tohtml" ;;
    "Claude → Excel"*)                    echo "--claude --unwrap --toexcel" ;;
    "Rich → Markdown"*)                   echo "--md --rtrim --strip-blank" ;;
    "Markdown → Rich"*)                   echo "--tohtml" ;;
    "Clean list"*)                        echo "--trim --dedup" ;;
    "Flatten text"*)                      echo "--trim --unformat --unwrap --collapse" ;;
    "--claude"*)                          echo "--claude" ;;
    "--md2csv"*)                          echo "--md2csv" ;;
    "--md2html"*)                         echo "--md2html" ;;
    "--md "*)                             echo "--md" ;;
    "--boxtable"*)                        echo "--boxtable" ;;
    "--unwrap"*)                          echo "--unwrap" ;;
    "--strip-blank"*)                     echo "--strip-blank" ;;
    "--trim"*)                            echo "--trim" ;;
    "--rtrim"*)                           echo "--rtrim" ;;
    "--collapse"*)                        echo "--collapse" ;;
    "--dedup"*)                           echo "--dedup" ;;
    "--unformat"*)                        echo "--unformat" ;;
    "--lower"*)                           echo "--lower" ;;
    "--upper"*)                           echo "--upper" ;;
    "--title"*)                           echo "--title" ;;
    "--sentence"*)                        echo "--sentence" ;;
    "--sort-r"*)                          echo "--sort-r" ;;
    "--sort"*)                            echo "--sort" ;;
    "--tohtml"*)                          echo "--tohtml" ;;
    "--toexcel"*)                         echo "--toexcel" ;;
    "--csv2md"*)                          echo "--csv2md" ;;
    "--csv2html"*)                        echo "--csv2html" ;;
    *) ;;
  esac
}

flags=""
if [ -f "$SEL_FILE" ] && [ -s "$SEL_FILE" ]; then
  while IFS= read -r line_num; do
    [ -z "$line_num" ] && continue
    # Resolve line number to item label (line numbers are 0-based from fzf {n})
    sel=$(sed -n "$((line_num + 1))p" "$ITEMS_FILE" 2>/dev/null)
    [ -z "$sel" ] && continue
    f=$(label_to_flags "$sel")
    [ -n "$f" ] && flags="$flags $f"
  done < "$SEL_FILE"
fi

if [ -z "$flags" ]; then
  d='\033[38;5;240m'
  r='\033[0m'
  echo -e "  ${d}── Clipboard contents (raw) ──${r}"
  echo ""
  cat "$CLIP_TMP" | head -50
else
  echo "── clip$flags ──"
  echo ""
  # shellcheck disable=SC2086
  output=$(cat "$CLIP_TMP" | "$CLIP" $flags --no-copy 2>/dev/null)

  # If output looks like HTML, render it for readable preview
  if echo "$output" | head -1 | grep -q '<[a-z]'; then
    if command -v pandoc &>/dev/null; then
      echo "$output" | pandoc -f html -t gfm --wrap=auto 2>/dev/null
    else
      # Strip HTML tags as fallback
      echo "$output" | sed 's/<[^>]*>//g; /^$/d'
    fi
  else
    echo "$output" | head -50
  fi
fi
PREVIEW_EOF
chmod +x "$PREVIEW_SCRIPT"

# ──────────────────────────────────────────────
# Build the item list
# ──────────────────────────────────────────────

items="Claude → Markdown            (--claude --unwrap)
Claude → Rich                (--claude --unwrap --tohtml)
Claude → Excel               (--claude --unwrap --toexcel)
Rich → Markdown              (--md --rtrim --strip-blank)
Markdown → Rich              (--tohtml)
Clean list                   (--trim --dedup)
Flatten text                 (--trim --unformat --unwrap --collapse)
───────────────────────────────────
--claude                     Claude terminal → clean Markdown
--md                         Rich HTML clipboard → Markdown
--boxtable                   Box-drawing table → Markdown table
--unwrap                     Rejoin hard-wrapped paragraph lines
───────────────────────────────────
--trim                       Strip leading + trailing whitespace
--rtrim                      Strip trailing whitespace only
--strip-blank                Remove blank lines
--collapse                   Collapse whitespace runs to single space
--dedup                      Remove duplicate lines
--unformat                   Normalize smart quotes, dashes, spaces
───────────────────────────────────
--lower                      lowercase
--upper                      UPPERCASE
--title                      Title Case
--sentence                   Sentence case
───────────────────────────────────
--sort                       Sort lines A → Z
--sort-r                     Sort lines Z → A
───────────────────────────────────
--tohtml                     → Rich HTML (Gmail, Mail, Word, Notes)
--toexcel                    → Excel-friendly (tables as TSV, strips markdown)
--csv2md                     → CSV to Markdown table
--csv2html                   → CSV to HTML table (Apple Notes)
--md2csv                     → Markdown table to Excel TSV
--md2html                    → Markdown table to HTML table"

# Save items to file for line-number lookup in preview
echo "$items" > "$ITEMS_FILE"

# ──────────────────────────────────────────────
# Run fzf
# ──────────────────────────────────────────────

# Detect fzf capabilities
fzf_version=$(fzf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
fzf_major=$(echo "$fzf_version" | cut -d. -f1)
fzf_minor=$(echo "$fzf_version" | cut -d. -f2)
# Treat fzf 1.0+ as having all features
fzf_ver_num=$((fzf_major * 100 + fzf_minor))

fzf_args=(
  --multi
  --no-sort
  --cycle
  --reverse
  --height=100%
  --preview="$PREVIEW_SCRIPT $CLIP_TMP $SEL_FILE $ITEMS_FILE"
  --preview-window=right:55%:wrap
  --ansi
  --prompt="transforms> "
  --marker="✓"
  --pointer="▸"
)

# Features available in fzf 0.35+
if [[ "$fzf_ver_num" -ge 35 ]]; then
  fzf_args+=(
    --border=rounded
    --header="$(printf '\033[38;5;129m ██████╗\033[38;5;135m██╗     \033[38;5;171m██╗\033[38;5;209m██████╗ \033[0m\n\033[38;5;129m██╔════╝\033[38;5;135m██║     \033[38;5;171m██║\033[38;5;209m██╔══██╗\033[0m\n\033[38;5;135m██║     \033[38;5;171m██║     \033[38;5;171m██║\033[38;5;209m██████╔╝\033[0m\n\033[38;5;171m██║     \033[38;5;207m██║     \033[38;5;209m██║\033[38;5;215m██╔═══╝ \033[0m\n\033[38;5;207m╚██████╗\033[38;5;209m███████╗\033[38;5;215m██║\033[38;5;221m██║     \033[0m\n\033[38;5;209m ╚═════╝\033[38;5;215m╚══════╝\033[38;5;221m╚═╝\033[38;5;221m╚═╝     \033[0m\n\033[38;5;240m ✂ clipboard transformer\033[0m\n\n Tab: toggle  Enter: apply  Ctrl-C: cancel\n Del: clear   R: refresh')"
    --color='border:#8b5cf6,header:#6b7280'
  )
else
  fzf_args+=(
    --header="clip — Tab: toggle  Enter: apply  Ctrl-C: cancel"
  )
fi

# Features available in fzf 0.36+ (execute-silent, refresh-preview, header-first)
if [[ "$fzf_ver_num" -ge 36 ]]; then
  fzf_args+=(
    --header-first
    --bind "tab:execute-silent($TOGGLE_SCRIPT {n})+toggle+down+refresh-preview"
  )
else
  fzf_args+=(
    --bind "tab:toggle+down"
  )
fi

# Features available in fzf 0.46+
if [[ "$fzf_ver_num" -ge 46 ]]; then
  fzf_args+=(
    --border-label=" ✂ "
    --border-label-pos=3
    --color='label:#8b5cf6'
    --bind "del:execute-silent(: > $CLIP_TMP; : > $SEL_FILE)+reload(echo \"$items\")+clear-selection"
    --bind "r:execute-silent($REFRESH_SCRIPT)+refresh-preview"
  )
fi

selected=$(echo "$items" | fzf "${fzf_args[@]}") || { echo "[clip-tui] Cancelled"; exit 0; }

# ──────────────────────────────────────────────
# Build and execute clip command
# ──────────────────────────────────────────────

flags=""
while IFS= read -r sel; do
  [ -z "$sel" ] && continue
  case "$sel" in "──"*) continue ;; esac
  f=$(label_to_flags "$sel")
  [ -n "$f" ] && flags="$flags $f"
done <<< "$selected"

if [ -z "$flags" ]; then
  echo "[clip-tui] No transforms selected"
  exit 0
fi

# shellcheck disable=SC2086
cat "$CLIP_TMP" | "$CLIP" $flags
