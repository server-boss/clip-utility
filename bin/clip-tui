#!/usr/bin/env bash
set -eo pipefail
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# ──────────────────────────────────────────────
# clip-tui — interactive clipboard transformer
# ──────────────────────────────────────────────
# Uses fzf multi-select with live preview.
# Select transforms with Tab, press Enter to apply.

CLIP="clip"

# ── Platform clipboard helpers ──
_is_wsl() { grep -qi microsoft /proc/version 2>/dev/null; }

clip_paste() {
  case "$(uname -s)" in
    Darwin)  pbpaste ;;
    Linux)
      if _is_wsl; then powershell.exe -NoProfile -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Get-Clipboard" 2>/dev/null | sed 's/\r$//'
      elif command -v wl-paste &>/dev/null; then wl-paste 2>/dev/null
      elif command -v xclip &>/dev/null; then xclip -selection clipboard -o 2>/dev/null
      elif command -v xsel &>/dev/null; then xsel --clipboard --output 2>/dev/null
      fi ;;
  esac
}

clip_clear() {
  case "$(uname -s)" in
    Darwin)  pbcopy < /dev/null ;;
    Linux)
      if _is_wsl; then powershell.exe -NoProfile -Command "Set-Clipboard -Value ''" 2>/dev/null
      elif command -v xclip &>/dev/null; then echo -n | xclip -selection clipboard -i 2>/dev/null
      elif command -v wl-copy &>/dev/null; then wl-copy --clear 2>/dev/null
      fi ;;
  esac
}

# ──────────────────────────────────────────────
# Label → flags mapping
# ──────────────────────────────────────────────

label_to_flags() {
  case "$1" in
    # Presets
    "Claude → Markdown"*)                 echo "--claude --unwrap" ;;
    "Claude → Rich"*)                     echo "--claude --unwrap --tohtml" ;;
    "Claude → Excel"*)                    echo "--claude --unwrap --toexcel" ;;
    "Rich → Markdown"*)                   echo "--md --rtrim --strip-blank" ;;
    "Markdown → Rich"*)                   echo "--tohtml" ;;
    "Clean list"*)                        echo "--trim --dedup" ;;
    "Flatten text"*)                      echo "--trim --unformat --unwrap --collapse" ;;
    # Clipboard Source
    "--claude"*)                          echo "--claude" ;;
    "--md"*)                              echo "--md" ;;
    "--boxtable"*)                        echo "--boxtable" ;;
    "--unwrap"*)                          echo "--unwrap" ;;
    # Formatting
    "--trim"*)                            echo "--trim" ;;
    "--rtrim"*)                           echo "--rtrim" ;;
    "--strip-blank"*)                     echo "--strip-blank" ;;
    "--collapse"*)                        echo "--collapse" ;;
    "--dedup"*)                           echo "--dedup" ;;
    "--unformat"*)                        echo "--unformat" ;;
    # Case
    "--lower"*)                           echo "--lower" ;;
    "--upper"*)                           echo "--upper" ;;
    "--title"*)                           echo "--title" ;;
    "--sentence"*)                        echo "--sentence" ;;
    # Sort
    "--sort-r"*)                          echo "--sort-r" ;;
    "--sort"*)                            echo "--sort" ;;
    # Paste Destination
    "--tohtml"*)                          echo "--tohtml" ;;
    "--toexcel"*)                         echo "--toexcel" ;;
    "--csv2md"*)                          echo "--csv2md" ;;
    "--csv2html"*)                        echo "--csv2html" ;;
    "--md2csv"*)                          echo "--md2csv" ;;
    "--md2html"*)                         echo "--md2html" ;;
    *) ;;
  esac
}

# ──────────────────────────────────────────────
# Build the preview script
# ──────────────────────────────────────────────

# Cache clipboard to temp file (avoids repeated powershell.exe calls on WSL)
CLIP_TMP="${TMPDIR:-/tmp}/.clip-tui-input-$$"
REFRESH_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-refresh-$$"
clip_paste > "$CLIP_TMP"
trap 'rm -f "$CLIP_TMP" "$PREVIEW_SCRIPT" "$REFRESH_SCRIPT"' EXIT

# Refresh script — re-reads clipboard into the cache file
cat > "$REFRESH_SCRIPT" << REFRESH_EOF
#!/usr/bin/env bash
$(declare -f _is_wsl)
$(declare -f clip_paste)
clip_paste > "$CLIP_TMP"
REFRESH_EOF
chmod +x "$REFRESH_SCRIPT"

PREVIEW_SCRIPT="${TMPDIR:-/tmp}/.clip-tui-preview-$$"
cat > "$PREVIEW_SCRIPT" << 'PREVIEW_EOF'
#!/usr/bin/env bash
set -eo pipefail
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

CLIP="clip"
CLIP_TMP="$1"
shift

label_to_flags() {
  case "$1" in
    "Claude → Markdown"*)                 echo "--claude --unwrap" ;;
    "Claude → Rich"*)                     echo "--claude --unwrap --tohtml" ;;
    "Claude → Excel"*)                    echo "--claude --unwrap --toexcel" ;;
    "Rich → Markdown"*)                   echo "--md --rtrim --strip-blank" ;;
    "Markdown → Rich"*)                   echo "--tohtml" ;;
    "Clean list"*)                        echo "--trim --dedup" ;;
    "Flatten text"*)                      echo "--trim --unformat --unwrap --collapse" ;;
    "--claude"*)                          echo "--claude" ;;
    "--md"*)                              echo "--md" ;;
    "--boxtable"*)                        echo "--boxtable" ;;
    "--unwrap"*)                          echo "--unwrap" ;;
    "--trim"*)                            echo "--trim" ;;
    "--rtrim"*)                           echo "--rtrim" ;;
    "--strip-blank"*)                     echo "--strip-blank" ;;
    "--collapse"*)                        echo "--collapse" ;;
    "--dedup"*)                           echo "--dedup" ;;
    "--unformat"*)                        echo "--unformat" ;;
    "--lower"*)                           echo "--lower" ;;
    "--upper"*)                           echo "--upper" ;;
    "--title"*)                           echo "--title" ;;
    "--sentence"*)                        echo "--sentence" ;;
    "--sort-r"*)                          echo "--sort-r" ;;
    "--sort"*)                            echo "--sort" ;;
    "--tohtml"*)                          echo "--tohtml" ;;
    "--toexcel"*)                         echo "--toexcel" ;;
    "--csv2md"*)                          echo "--csv2md" ;;
    "--csv2html"*)                        echo "--csv2html" ;;
    "--md2csv"*)                          echo "--md2csv" ;;
    "--md2html"*)                         echo "--md2html" ;;
    *) ;;
  esac
}

selections_file="$1"

flags=""
if [ -f "$selections_file" ]; then
  while IFS= read -r sel; do
    [ -z "$sel" ] && continue
    f=$(label_to_flags "$sel")
    [ -n "$f" ] && flags="$flags $f"
  done < "$selections_file"
fi

if [ -z "$flags" ]; then
  d='\033[38;5;240m'
  r='\033[0m'
  echo -e "  ${d}── Clipboard contents (raw) ──${r}"
  echo ""
  cat "$CLIP_TMP" | head -50
else
  echo "── clip$flags ──"
  echo ""
  # shellcheck disable=SC2086
  cat "$CLIP_TMP" | "$CLIP" $flags --no-copy 2>/dev/null | head -50
fi
PREVIEW_EOF
chmod +x "$PREVIEW_SCRIPT"

# ──────────────────────────────────────────────
# Build the item list
# ──────────────────────────────────────────────

items="Claude → Markdown            (--claude --unwrap)
Claude → Rich                (--claude --unwrap --tohtml)
Claude → Excel               (--claude --unwrap --toexcel)
Rich → Markdown              (--md --rtrim --strip-blank)
Markdown → Rich              (--tohtml)
Clean list                   (--trim --dedup)
Flatten text                 (--trim --unformat --unwrap --collapse)
───────────────────────────────────
--claude                     Claude terminal → clean Markdown
--md                         Rich HTML clipboard → Markdown
--boxtable                   Box-drawing table → Markdown table
--unwrap                     Rejoin hard-wrapped paragraph lines
───────────────────────────────────
--trim                       Strip leading + trailing whitespace
--rtrim                      Strip trailing whitespace only
--strip-blank                Remove blank lines
--collapse                   Collapse whitespace runs to single space
--dedup                      Remove duplicate lines
--unformat                   Normalize smart quotes, dashes, spaces
───────────────────────────────────
--lower                      lowercase
--upper                      UPPERCASE
--title                      Title Case
--sentence                   Sentence case
───────────────────────────────────
--sort                       Sort lines A → Z
--sort-r                     Sort lines Z → A
───────────────────────────────────
--tohtml                     → Rich HTML (Gmail, Mail, Word, Notes)
--toexcel                    → Excel-friendly (tables as TSV, strips markdown)
--csv2md                     → CSV to Markdown table
--csv2html                   → CSV to HTML table (Apple Notes)
--md2csv                     → Markdown table to Excel TSV
--md2html                    → Markdown table to HTML table"

# ──────────────────────────────────────────────
# Run fzf
# ──────────────────────────────────────────────

# Detect fzf capabilities
fzf_version=$(fzf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
fzf_major=$(echo "$fzf_version" | cut -d. -f1)
fzf_minor=$(echo "$fzf_version" | cut -d. -f2)

fzf_args=(
  --multi
  --no-sort
  --cycle
  --reverse
  --height=100%
  --preview="$PREVIEW_SCRIPT $CLIP_TMP {+f}"
  --preview-window=right:55%:wrap
  --ansi
  --prompt="transforms> "
  --marker="✓"
  --pointer="▸"
)

# Features available in fzf 0.35+
if [[ "$fzf_minor" -ge 35 ]] 2>/dev/null; then
  fzf_args+=(
    --border=rounded
    --header="clip ✂ clipboard transformer

 Tab: toggle  Enter: apply  Ctrl-C: cancel"
    --color='border:#8b5cf6,header:#6b7280'
  )
else
  fzf_args+=(
    --header="clip — Tab: toggle  Enter: apply  Ctrl-C: cancel"
  )
fi

# Features available in fzf 0.36+
if [[ "$fzf_minor" -ge 36 ]] 2>/dev/null; then
  fzf_args+=(--header-first)
fi

# Features available in fzf 0.46+
if [[ "$fzf_minor" -ge 46 ]] 2>/dev/null; then
  fzf_args+=(
    --border-label=" ✂ "
    --border-label-pos=3
    --color='label:#8b5cf6'
    --bind "del:execute-silent(: > $CLIP_TMP)+reload(echo \"$items\")+clear-selection"
    --bind "r:execute-silent($REFRESH_SCRIPT)+refresh-preview"
  )
fi

selected=$(echo "$items" | fzf "${fzf_args[@]}") || { echo "[clip-tui] Cancelled"; exit 0; }

# ──────────────────────────────────────────────
# Build and execute clip command
# ──────────────────────────────────────────────

flags=""
while IFS= read -r sel; do
  [ -z "$sel" ] && continue
  case "$sel" in "──"*) continue ;; esac
  f=$(label_to_flags "$sel")
  [ -n "$f" ] && flags="$flags $f"
done <<< "$selected"

if [ -z "$flags" ]; then
  echo "[clip-tui] No transforms selected"
  exit 0
fi

# shellcheck disable=SC2086
cat "$CLIP_TMP" | "$CLIP" $flags
